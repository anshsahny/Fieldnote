{
  "$id": "https://github.com/anshsahny/Fieldnote/shared/fixpack.schema.json",
  "title": "Fieldnote fix pack (schemaVersion 1)",
  "description": "Generated from web/src/fixpack/schema.ts. Cross-reference rules (next targets exist, no orphans or cycles, universal safety stops, strings <= 200 chars, pack <= 25 KB) are enforced by the validators on web and iOS.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "equipmentType": {
      "type": "string",
      "enum": [
        "gas_furnace",
        "heat_pump",
        "air_conditioner",
        "boiler"
      ]
    },
    "displayType": {
      "type": "string",
      "enum": [
        "led_flash",
        "seven_segment",
        "mixed"
      ]
    },
    "modelPatterns": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceRefs": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "pages": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    "faultCodes": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "likelyCauses": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "firstStep": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "display",
          "meaning",
          "likelyCauses",
          "firstStep",
          "sourceRef",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,32}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "ask": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "observation",
                  "yesno",
                  "reading"
                ]
              },
              "options": {
                "minItems": 2,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          "next": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "outcome": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "fix",
                  "escalate",
                  "resolved"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "parts": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "summary"
            ],
            "additionalProperties": false
          },
          "safety": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pages": {
            "type": "string"
          }
        },
        "required": [
          "instruction"
        ],
        "additionalProperties": false
      }
    },
    "safetyStops": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
          },
          "triggers": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "triggers",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "brand",
    "family",
    "equipmentType",
    "displayType",
    "modelPatterns",
    "version",
    "sourceRefs",
    "faultCodes",
    "steps",
    "safetyStops"
  ],
  "additionalProperties": false
}
