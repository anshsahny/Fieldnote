# Copy to .local-secrets (gitignored) and fill in, then run: node scripts/setup-local-secrets.mjs
# reCAPTCHA Enterprise site key registered for the web app in App Check
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key
# App Check debug tokens (Firebase console -> App Check -> Apps -> ⋮ -> Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
IOS_SIM_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
IOS_DEVICE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
