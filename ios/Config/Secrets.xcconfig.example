// Copy to ios/Config/Secrets.xcconfig (gitignored), or generate it with:
//   node scripts/setup-local-secrets.mjs
// Only Debug builds include this file. Register both tokens in
// Firebase console -> App Check -> Apps -> iOS app -> Manage debug tokens.
FN_APPCHECK_DEBUG_TOKEN_SIMULATOR = 00000000-0000-0000-0000-000000000000
FN_APPCHECK_DEBUG_TOKEN_DEVICE = 00000000-0000-0000-0000-000000000000
