rules_version = '2';

// Fieldnote Firestore rules (P0 baseline; P2 adds emulator tests with @firebase/rules-unit-testing).
// Model: users/{uid} holds { orgId, role: 'tech' | 'dispatcher' }. Everything else lives under
// orgs/{orgId}/... and is visible only to members of that org.
// users/{uid} docs are provisioned by the seed script (Admin SDK), never by clients, so a client
// can't pick its own org or promote itself to dispatcher.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function inOrg(orgId) {
      return hasProfile() && profile().orgId == orgId;
    }

    function isDispatcher(orgId) {
      return inOrg(orgId) && profile().role == 'dispatcher';
    }

    // Published fix pack envelope (orgs/{orgId}/fixpacks/{packId}).
    function validFixPackDoc(d, packId) {
      return d.packId == packId
        && d.status == 'published'
        && d.version is int && d.version >= 1
        && d.packJson is string && d.packJson.size() <= 26000
        && d.brand is string && d.brand.size() <= 200
        && d.family is string && d.family.size() <= 200
        && d.modelPatterns is list && d.modelPatterns.size() <= 10
        && d.publishedBy == request.auth.uid;
    }

    // Ledger rows are metadata only (no prompt/response content), small, and typed.
    // ts is client-set because iOS logs events offline and syncs them later.
    function validInferenceEvent(d) {
      return d.keys().hasAll(['feature', 'platform', 'source', 'latencyMs', 'ts'])
        && d.keys().hasOnly(['feature', 'platform', 'source', 'latencyMs', 'promptTokensEst',
                             'ts', 'model', 'mode', 'ok'])
        && d.feature is string && d.feature.size() <= 64
        && d.platform in ['ios', 'web']
        && d.source in ['ON_DEVICE', 'IN_CLOUD', 'NONE']
        && d.latencyMs is number && d.latencyMs >= 0 && d.latencyMs < 600000
        && d.ts is timestamp
        && (!('promptTokensEst' in d) || (d.promptTokensEst is int && d.promptTokensEst >= 0
                                          && d.promptTokensEst < 1000000))
        && (!('model' in d) || (d.model is string && d.model.size() <= 128))
        && (!('mode' in d) || (d.mode is string && d.mode.size() <= 32))
        && (!('ok' in d) || d.ok is bool);
    }

    // "Try the demo" (P5): anonymous sign-in, demo org only. Guests read everything in the demo org,
    // log web ledger rows, and attach a triage result to a demo job. Nothing destructive.
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isDemoGuest(orgId) {
      return isGuest() && orgId == 'demo';
    }

    function canRead(orgId) {
      return inOrg(orgId) || isDemoGuest(orgId);
    }

    // Photo pre-triage attached to a job from the web console (see web/src/triage).
    function validTriage(t) {
      return t is map
        && t.keys().hasAll(['likelyFault', 'source', 'attachedAt'])
        && t.keys().hasOnly(['brand', 'model', 'errorCode', 'likelyFault', 'partsToBring', 'confidence',
                             'source', 'latencyMs', 'packId', 'matchedCode', 'photoStayedOnDevice', 'attachedAt'])
        && t.likelyFault is string && t.likelyFault.size() <= 300
        && t.source in ['ON_DEVICE', 'IN_CLOUD']
        && t.attachedAt is timestamp
        && (!('brand' in t) || (t.brand is string && t.brand.size() <= 80))
        && (!('model' in t) || (t.model is string && t.model.size() <= 80))
        && (!('errorCode' in t) || (t.errorCode is string && t.errorCode.size() <= 32))
        && (!('partsToBring' in t) || (t.partsToBring is list && t.partsToBring.size() <= 10))
        && (!('confidence' in t) || (t.confidence is number && t.confidence >= 0 && t.confidence <= 1))
        && (!('latencyMs' in t) || (t.latencyMs is int && t.latencyMs >= 0))
        && (!('packId' in t) || (t.packId is string && t.packId.size() <= 128))
        && (!('matchedCode' in t) || (t.matchedCode is string && t.matchedCode.size() <= 32))
        && (!('photoStayedOnDevice' in t) || t.photoStayedOnDevice is bool);
    }

    // The signed-in tech is the one the job is assigned to.
    function isAssignedTech(orgId, jobId) {
      return inOrg(orgId)
        && get(/databases/$(database)/documents/orgs/$(orgId)/jobs/$(jobId)).data.assignedTo == request.auth.uid;
    }

    // Diagnosis session (iOS SessionState, P4). Written on every step, often offline.
    function validSession(d, jobId, sessionId) {
      return d.keys().hasAll(['schemaVersion', 'id', 'jobId', 'techUid', 'packId', 'packVersion', 'faultCode',
                              'status', 'stepId', 'history', 'acknowledgedStops', 'createdOffline',
                              'startedAt', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'id', 'jobId', 'techUid', 'packId', 'packVersion', 'faultCode',
                             'status', 'stepId', 'history', 'acknowledgedStops', 'createdOffline',
                             'startedAt', 'updatedAt'])
        && d.id == sessionId && d.jobId == jobId && d.techUid == request.auth.uid
        && d.status in ['active', 'concluded', 'abandoned']
        && d.packId is string && d.packId.size() <= 128
        && d.packVersion is int
        && d.faultCode is string && d.faultCode.size() <= 32
        && d.stepId is string && d.stepId.size() <= 64
        && d.history is list && d.history.size() <= 60
        && d.acknowledgedStops is list && d.acknowledgedStops.size() <= 30
        && d.createdOffline is bool
        && d.startedAt is timestamp && d.updatedAt is timestamp;
    }

    // Customer report (iOS ServiceReport, P4): PII-free facts + up to 4 model-written versions.
    function validReport(d, reportId) {
      return d.keys().hasAll(['schemaVersion', 'id', 'jobId', 'sessionId', 'techUid', 'facts', 'versions',
                              'status', 'generatedBy', 'createdOffline', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'id', 'jobId', 'sessionId', 'techUid', 'facts', 'versions',
                             'status', 'generatedBy', 'createdOffline', 'createdAt', 'updatedAt', 'upgradedAt'])
        && d.id == reportId && d.techUid == request.auth.uid
        && d.jobId is string && d.sessionId is string
        && d.status in ['draft', 'final']
        && d.generatedBy in ['ON_DEVICE', 'IN_CLOUD', 'PLAIN']
        && d.facts is map
        && d.versions is list && d.versions.size() >= 1 && d.versions.size() <= 4
        && d.createdOffline is bool
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && (!('upgradedAt' in d) || d.upgradedAt is timestamp);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /orgs/{orgId} {
      allow read: if canRead(orgId);
      allow write: if false;

      // Fix packs: everyone in the org reads; only dispatchers publish. The pack JSON was validated
      // in the console; the rules guard the envelope (identity, size, monotonic version).
      match /fixpacks/{packId} {
        allow read: if canRead(orgId);
        allow create: if isDispatcher(orgId) && validFixPackDoc(request.resource.data, packId);
        allow update: if isDispatcher(orgId) && validFixPackDoc(request.resource.data, packId)
          && request.resource.data.version > resource.data.version;
        allow delete: if isDispatcher(orgId);
      }

      // Jobs: dispatchers create/assign/edit/delete; the assigned tech may only touch progress
      // fields (so a tech can't reassign a job or rewrite the customer/address).
      match /jobs/{jobId} {
        allow read: if canRead(orgId);
        allow create, delete: if isDispatcher(orgId);
        allow update: if isDispatcher(orgId)
          || (inOrg(orgId)
              && resource.data.assignedTo == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'equipment', 'updatedAt'])
              && request.resource.data.status in ['new', 'scheduled', 'assigned', 'in_progress', 'done'])
          || (isDemoGuest(orgId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['triage', 'updatedAt'])
              && validTriage(request.resource.data.triage));

        // Diagnosis sessions: the assigned tech writes them (often offline, synced later).
        match /sessions/{sessionId} {
          allow read: if canRead(orgId);
          allow create: if isAssignedTech(orgId, jobId)
            && validSession(request.resource.data, jobId, sessionId);
          allow update: if isAssignedTech(orgId, jobId)
            && resource.data.techUid == request.auth.uid
            && validSession(request.resource.data, jobId, sessionId);
          allow delete: if isDispatcher(orgId);
        }
      }

      // Customer reports written by the assigned tech's app; dispatchers read them in the inbox.
      match /reports/{reportId} {
        allow read: if canRead(orgId);
        allow create: if validReport(request.resource.data, reportId)
          && isAssignedTech(orgId, request.resource.data.jobId);
        allow update: if resource.data.techUid == request.auth.uid
          && request.resource.data.jobId == resource.data.jobId
          && validReport(request.resource.data, reportId)
          && isAssignedTech(orgId, request.resource.data.jobId);
        allow delete: if isDispatcher(orgId);
      }

      // Hybrid Ledger: metadata only. Clients append; only dispatchers can read the ledger.
      match /inferenceEvents/{eventId} {
        allow create: if validInferenceEvent(request.resource.data)
          && (inOrg(orgId) || (isDemoGuest(orgId) && request.resource.data.platform == 'web'));
        allow read: if isDispatcher(orgId) || isDemoGuest(orgId);
        allow update, delete: if false;
      }
    }

    // Default deny for anything not matched above.
  }
}
