# Copy to web/.env.development.local (gitignored).
# Loaded by `npm run dev` only. `npm run build` never reads it, so the token can't reach dist/.
# Register this token in Firebase console -> App Check -> Apps -> web app -> Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
# Optional, for the dev-only "sign in as demo user" buttons (generated by npm run seed).
VITE_DEMO_DISPATCHER_PASSWORD=
VITE_DEMO_TECH_PASSWORD=
